# Firebase (Web config values — used by @react-native-firebase for RTDB/Firestore URLs
# where needed; native Android/iOS config comes from google-services.json /
# GoogleService-Info.plist, see README).
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_DATABASE_URL=https://your-firebase-project-id-default-rtdb.firebaseio.com

# Cloudinary (used for chat image/file uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_UPLOAD_PRESET=lazychat_unsigned
CLOUDINARY_API_BASE=https://api.cloudinary.com/v1_1

# EAS
EAS_PROJECT_ID=your-eas-project-id
