# Supabase (Project Settings -> API in the Supabase dashboard)
# Neither of these is a secret you need to hide: SUPABASE_URL identifies your
# project, and the "anon" key is designed to ship inside client apps — access
# control comes from Row Level Security policies (see supabase/migrations/),
# not from keeping this key private.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# EAS (only needed once you run `eas init`)
EAS_PROJECT_ID=your-eas-project-id
