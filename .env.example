# Supabase (Project Settings -> API in the Supabase dashboard)
# Neither of these is a secret you need to hide: the URL identifies your
# project, and the anon/publishable key is designed to ship inside client
# code — access control comes from the Row Level Security policies in
# supabase/migrations/, not from keeping this key private.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Web Push VAPID public key (safe to expose client-side — pairs with the
# private key set as an Edge Function secret, never put the private key here).
# Generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
